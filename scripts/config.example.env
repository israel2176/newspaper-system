# Local run:  set -a; source scripts/config.example.env; set +a
#             python scripts/newspaper_pipeline.py all
# On GitHub these are repository Secrets (EMAIL_USER, EMAIL_PASS) and Variables (the rest).

# Mailbox that receives the newspaper (recommended: a dedicated Gmail account)
EMAIL_USER=my-newspaper-inbox@gmail.com
# Gmail App Password: https://myaccount.google.com/apppasswords  (needs 2-Step Verification)
EMAIL_PASS=xxxx xxxx xxxx xxxx
IMAP_HOST=imap.gmail.com

# Optional filters (comma separated, substring match). Empty = every email with a PDF.
SENDER_FILTER=
SUBJECT_FILTER=

# How many issues to keep on the site (0 = keep all)
MAX_ISSUES=11
NEWSPAPER_NAME=עמנואל שלי

# Image quality
PAGE_HEIGHT=1800
JPG_QUALITY=80
