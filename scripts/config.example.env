# Local run:  set -a; source scripts/config.example.env; set +a
#             python scripts/newspaper_pipeline.py inbox
# On GitHub these are optional repository Variables.

# How many issues to keep on the site (0 = keep all)
MAX_ISSUES=11
NEWSPAPER_NAME=עמנואל שלי

# Image quality
PAGE_HEIGHT=1800
JPG_QUALITY=80
